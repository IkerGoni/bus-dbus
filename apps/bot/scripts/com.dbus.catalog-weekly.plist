<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Plantilla launchd para refrescar el catálogo semanalmente.
  Antes de cargarla con `launchctl load`, sustituye los placeholders:
    sed -e "s|__REPO_ROOT__|/ruta/a/bus-dbus|g" \
        -e "s|__LOG_DIR__|/tmp|g" \
        apps/bot/scripts/com.dbus.catalog-weekly.plist > ~/Library/LaunchAgents/com.dbus.catalog-weekly.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dbus.catalog-weekly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>__REPO_ROOT__/apps/bot/scripts/refresh-catalog-weekly.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>0</integer>
    <key>Hour</key><integer>3</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/dbus-catalog-refresh.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/dbus-catalog-refresh.log</string>
</dict>
</plist>
