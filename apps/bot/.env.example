# Dbus Telegram Bot configuration

# Token del bot (Telegram @BotFather). Nunca commitear el real.
BOT_TOKEN=tu_token_de_bot_aqui

# API JSON pública de Dbus (HTTP, sin auth). HTTPS no responde.
DBUS_BASE_URL=http://app.dbus.eus/SSIIMovilWSv2/ws/cons

# Idioma de destinos/nombres: eu | es | en | fr
BOT_LANGUAGE=es

# Nivel de log: debug | info | warn | error | silent (default info)
LOG_LEVEL=info

# Caché de llegadas y refresco en segundo plano (ms)
CACHE_TTL_MS=30000
POLL_INTERVAL_MS=30000

# Minutos de antelación por defecto para avisos
DEFAULT_ALERT_MINUTES=5

# Ruta de la base de datos SQLite
DB_PATH=./bot.db

# Paradas cercanas (OpenStreetMap/Overpass). Sin credenciales. Las coordenadas
# del usuario se usan solo en memoria: nunca se persisten.
NEARBY_ENABLED=1
OVERPASS_URL=https://overpass-api.de/api/interpreter
NEARBY_RADIUS_M=500
NEARBY_TIMEOUT_MS=30000
