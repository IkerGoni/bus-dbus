{
  "name": "@dbus/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "build:catalog": "node scripts/build-catalog.mjs",
    "build:coordinates": "node scripts/build-stop-coordinates.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -b",
    "test": "BOT_TOKEN=vitest_test_token DB_DRIVER=memory vitest run",
    "verify": "tsc -b && biome check src tests && BOT_TOKEN=vitest_test_token DB_DRIVER=memory vitest run"
  },
  "dependencies": {
    "@dbus/contracts": "workspace:*",
    "@dbus/core": "workspace:*",
    "node-cron": "^3.0.3",
    "postgres": "^4.1.1",
    "telegraf": "^4.16.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "pg-mem": "^3.0.14",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
