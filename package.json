{
  "name": "bus-dbus",
  "version": "0.1.0-beta",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @dbus/mobile dev",
    "dev:bot": "pnpm --filter @dbus/bot dev",
    "build": "pnpm --filter @dbus/contracts build && pnpm --filter @dbus/core build && pnpm --filter @dbus/mobile build",
    "typecheck": "tsc -b packages/contracts packages/core apps/bot",
    "typecheck:all": "tsc -b",
    "test": "pnpm -r test",
    "lint": "biome check apps/bot packages",
    "lint:all": "biome check .",
    "verify": "pnpm lint && pnpm typecheck && pnpm -r test"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.7.3"
  }
}
